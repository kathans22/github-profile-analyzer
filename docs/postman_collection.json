{
  "info": {
    "name": "GitHub Profile Analyzer",
    "_postman_id": "github-profile-analyzer-v1",
    "description": "API collection for the GitHub Profile Analyzer service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/health" }
      }
    },
    {
      "name": "Analyze GitHub Profile",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/profiles/analyze/torvalds",
          "path": ["api", "profiles", "analyze", "torvalds"]
        },
        "description": "Fetches the given GitHub username, computes insights, and persists them. Re-analyzing overwrites the latest data but keeps stat history."
      }
    },
    {
      "name": "List All Profiles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/profiles?page=1&limit=20&sortBy=analyzed_at&order=desc",
          "query": [
            { "key": "page",   "value": "1" },
            { "key": "limit",  "value": "20" },
            { "key": "sortBy", "value": "analyzed_at", "description": "Options: analyzed_at | followers | stars | username" },
            { "key": "order",  "value": "desc", "description": "asc | desc" }
          ]
        }
      }
    },
    {
      "name": "Get Single Profile",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/profiles/torvalds",
          "path": ["api", "profiles", "torvalds"]
        },
        "description": "Returns full analysis: profile, stats, languages, top repos, activity summary, and stats history."
      }
    },
    {
      "name": "Delete Profile",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/api/profiles/torvalds",
          "path": ["api", "profiles", "torvalds"]
        }
      }
    }
  ]
}
